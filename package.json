{
  "name": "lazyish",
  "version": "2.0.0",
  "type": "module",
  "description": "A lightweight, zero-dependency lazy loading micro-library using native browser APIs",
  "main": "dist/lazyish.cjs",
  "module": "dist/lazyish.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lazyish.esm.js",
      "require": "./dist/lazyish.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && rollup -c",
    "test": "vitest run",
    "test:package": "node test/package-smoke.mjs",
    "lint": "eslint src test",
    "size": "size-limit",
    "prepack": "npm run build"
  },
  "size-limit": [
    {
      "path": "dist/lazyish.esm.js",
      "limit": "2 KB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@size-limit/preset-small-lib": "13.0.3",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "rollup": "4.63.1",
    "size-limit": "13.0.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "keywords": [
    "lazy",
    "loading",
    "images",
    "intersection-observer",
    "typescript"
  ],
  "author": "smonist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smonist/lazyish.git"
  }
}
